{
  "name": "canvas-library-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @canvas/playground dev",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.1",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-tsc": "^2.0.29"
  }
}
