{
  "name": "board-library-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:docs",
    "build:packages": "pnpm --filter @lupinum/board-core build && pnpm --filter @lupinum/board-history --filter @lupinum/vue-board -r build && pnpm --filter @lupinum/board-connections build && pnpm --filter nuxt-board build",
    "build:docs": "pnpm --filter docs build",
    "dev": "pnpm dev:playground",
    "dev:docs": "pnpm --filter docs dev",
    "dev:playground": "pnpm --filter @lupinum/board-playground dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:hygiene": "node scripts/check-workspace-hygiene.mjs",
    "lint": "pnpm --filter docs lint && pnpm --filter nuxt-board lint",
    "pack:check": "node scripts/pack-check.mjs",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:docs": "pnpm --filter docs typecheck && pnpm --filter docs build",
    "test:e2e": "playwright test",
    "test:unit": "pnpm check:hygiene && vitest run --exclude packages/nuxt-board/test/basic.test.ts --exclude tests/large-board.test.ts && pnpm test:performance && pnpm --filter nuxt-board test",
    "test:performance": "vitest run tests/large-board.test.ts",
    "typecheck": "pnpm typecheck:workspace && pnpm --filter docs typecheck && pnpm --filter nuxt-board test:types",
    "typecheck:workspace": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.5",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion": "5.0.6",
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "read-yaml-file>js-yaml": "3.14.2",
      "launch-editor": "2.14.1",
      "shell-quote": "1.8.4",
      "tar": "7.5.16",
      "ws": "8.21.0"
    }
  }
}
