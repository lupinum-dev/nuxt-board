{
  "name": "board-library-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:docs",
    "build:packages": "pnpm --filter ./packages/board-core --filter ./packages/vue-board --filter ./packages/board-history --filter ./packages/board-selection --filter ./packages/board-connections --filter ./packages/board-minimap --filter ./packages/board-serializer --filter ./packages/nuxt-board -r build",
    "build:docs": "pnpm docs:api && pnpm --filter docs build",
    "dev": "pnpm dev:playground",
    "dev:docs": "pnpm docs:api && pnpm --filter docs dev",
    "dev:playground": "pnpm --filter @lupinum/board-playground dev",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm --filter docs lint && pnpm --filter @lupinum/nuxt-board lint",
    "pack:check": "node scripts/pack-check.mjs",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:docs": "pnpm docs:api && pnpm --filter docs typecheck && pnpm --filter docs build",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --exclude packages/nuxt-board/test/basic.test.ts && pnpm --filter @lupinum/nuxt-board test",
    "typecheck": "pnpm typecheck:workspace && pnpm --filter docs typecheck && pnpm --filter @lupinum/nuxt-board test:types",
    "typecheck:workspace": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.54.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.2.4",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.2.6"
  }
}
