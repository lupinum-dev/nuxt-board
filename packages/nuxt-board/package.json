{
  "name": "@lupinum/nuxt-board",
  "version": "0.1.0",
  "description": "Nuxt module for @lupinum/vue-board with board component and composable auto-imports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mat4m0/canvas.git",
    "directory": "packages/nuxt-board"
  },
  "homepage": "https://vue-board.vercel.app",
  "bugs": {
    "url": "https://github.com/Mat4m0/canvas/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "board",
    "nuxt",
    "vue",
    "diagram"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "pnpm --filter @lupinum/board-core build && pnpm --filter @lupinum/vue-board build && pnpm run dev:prepare && vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lupinum/board-core": "workspace:*",
    "@lupinum/vue-board": "workspace:*",
    "@nuxt/kit": "^4.4.2"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0 <5.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "6.0.4",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.0",
    "nuxt": "^4.4.2",
    "typescript": "~6.0.2",
    "vite": "7.3.1",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
