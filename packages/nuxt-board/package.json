{
  "name": "nuxt-board",
  "version": "0.1.0",
  "description": "Nuxt module for @lupinum/vue-board with board component and composable auto-imports.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mat4m0/canvas.git",
    "directory": "packages/nuxt-board"
  },
  "homepage": "https://vue-board.vercel.app",
  "bugs": {
    "url": "https://github.com/Mat4m0/canvas/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "board",
    "nuxt",
    "vue",
    "diagram"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm run build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "test": "pnpm --filter @lupinum/board-core build && pnpm --filter @lupinum/vue-board build && pnpm run dev:prepare && vitest run --root ../.. packages/nuxt-board/test",
    "test:watch": "vitest watch --root ../.. packages/nuxt-board/test",
    "test:types": "pnpm run dev:prepare && vue-tsc --noEmit && pnpm exec nuxi typecheck playground && pnpm exec nuxi typecheck test/fixtures/basic && pnpm exec nuxi typecheck test/fixtures/prefixed"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8"
  },
  "peerDependencies": {
    "@lupinum/board-core": "workspace:*",
    "@lupinum/vue-board": "workspace:*",
    "nuxt": "^3.19.0 || ^4.0.0"
  },
  "devDependencies": {
    "@lupinum/board-core": "workspace:*",
    "@lupinum/vue-board": "workspace:*",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "20.19.0",
    "@vitejs/plugin-vue": "6.0.6",
    "eslint": "^10.7.0",
    "nuxt": "^4.5.1",
    "typescript": "~5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
