    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum/nuxt-board.git",
    "directory": "packages/board-selection"
  },
  "homepage": "https://vue-board.vercel.app",
  "bugs": {
    "url": "https://github.com/lupinum/nuxt-board/issues"
  },
  "keywords": [
    "board",
    "selection",
    "nodes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@lupinum/board-core": "workspace:^"
