{
  "name": "@lupinum/board-serializer",
  "version": "0.1.0",
  "description": "JSON Canvas serializer for Vue Board snapshots and engines.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum/nuxt-board.git",
    "directory": "packages/board-serializer"
  },
  "homepage": "https://vue-board.vercel.app",
  "bugs": {
    "url": "https://github.com/lupinum/nuxt-board/issues"
  },
  "keywords": [
    "board",
    "serializer",
    "json-canvas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@lupinum/board-connections": "workspace:^",
    "@lupinum/board-core": "workspace:^"
  }
}
