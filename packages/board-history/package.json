{
  "name": "@lupinum/board-history",
  "version": "1.0.0-beta.2",
  "description": "Undo and redo plugin for @lupinum/board-core.",
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-board.git",
    "directory": "packages/board-history"
  },
  "homepage": "https://nuxt-board.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-board/issues"
  },
  "keywords": [
    "board",
    "history",
    "undo",
    "redo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/vue.ts --format esm --clean && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@lupinum/board-core": "workspace:*",
    "@lupinum/vue-board": "workspace:*",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@lupinum/vue-board": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lupinum/board-core": "workspace:*",
    "@lupinum/vue-board": "workspace:*",
    "vue": "^3.5.0"
  }
}
